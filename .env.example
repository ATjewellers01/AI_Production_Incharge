# ── Database (READ-ONLY use only — this service never writes) ───────────────
# LOCAL TESTING: point this at your local restored copy (e.g. `o2d_local` in
# pgAdmin, restored from updatebackupnewone.backup):
#   DATABASE_URL="postgresql://postgres:<password>@localhost:5432/o2d_local"
#
# RENDER DEPLOY: as of 2026-09-14 this points at O2D's REAL PRODUCTION RDS
# database (database-1.c98u4y6sk2lz.ap-south-1.rds.amazonaws.com, db "o2d")
# — switched from an earlier Neon test-DB copy specifically so the ERP tab
# (which shares this same database, see prisma/schema.prisma's "ERP models"
# section) would have real data to show. This means the read-only guarantee
# (no .create(/.update(/.delete(/.upsert( anywhere in this repo) is now
# load-bearing, not just a nicety — and SKIP_AUTH_IN_DEV being left on
# below is a real production-data exposure, not just a test-data
# inconvenience. This RDS instance also requires a PLAIN (non-SSL)
# connection and only accepts connections from specific whitelisted IPs —
# see CLAUDE.md's Database section for both gotchas before assuming a
# connection failure here is the same kind of issue Neon/Jewel-Factory's
# RDS have (which need SSL).
#   DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL=""

# Jewel Factory's own production Postgres (AWS RDS), added 2026-09-13 — a
# SECOND, entirely separate business/database this same service now also
# reads from (see the dashboard's "Order to Delivery" / "Jewel Factory"
# source toggle). Also read-only; see prisma/jewel-factory/schema.prisma's
# own header for the same "never migrate this" rule that applies to
# DATABASE_URL above.
DATABASE_URL_JEWEL_FACTORY=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# MUST be the exact same value as at-order-to-dispatch-backend's own
# JWT_SECRET — this service verifies tokens O2D issues, it never issues its
# own. If this doesn't match, every login will fail with "Invalid or expired
# token" even with a correct password.
JWT_SECRET=""

# TESTING-ONLY bypass — when this is exactly "true", every API route skips
# auth entirely and acts as a fake SUPER_ADMIN (see lib/auth.ts). Unlike an
# earlier draft, this is DELIBERATELY allowed to run on Render too (a
# temporary choice for early testing, before real O2D login is wired up
# with the correct JWT_SECRET below).
# ⚠️ While this is "true" ANYONE who reaches this service's URL sees every
# order/karigar with no login at all — and since 2026-09-14 DATABASE_URL
# points at REAL production data (see above), this is a genuine live-data
# exposure, not just a test-data inconvenience. Set back to "false" (or
# unset both this and NEXT_PUBLIC_SKIP_AUTH_IN_DEV) once real login is
# being used for anything beyond active testing.
SKIP_AUTH_IN_DEV="false"
# Same bypass, but for the FRONTEND (skips the /login redirect) — must be
# set to the same value as SKIP_AUTH_IN_DEV above, and must start with
# NEXT_PUBLIC_ to reach the browser at all.
NEXT_PUBLIC_SKIP_AUTH_IN_DEV="false"

# ── OpenAI (dashboard narrative + chat) ──────────────────────────────────────
OPENAI_API_KEY=""
# Optional — defaults to gpt-4o if unset.
AI_INCHARGE_MODEL="gpt-4o"

# ── O2D's own API (the browser calls this directly for login only) ──────────
# Local: at-order-to-dispatch-backend running on its default port.
# Render: O2D's real public API URL (e.g. https://api-o2d.zold.in/api).
NEXT_PUBLIC_O2D_API_URL="http://localhost:5000/api"

# Local dev: this service's own `start` script defaults to 3100 to avoid
# clashing with Jewel Factory or O2D's frontend if all three run locally at
# once. On Render: the Dockerfile now hardcodes PORT=10000 (Render's own
# convention for Docker web services, and the port it auto-detects/routes
# to) — don't set a PORT env var in the Render dashboard, it would override
# the Dockerfile's value and break routing again.
PORT="3100"
NODE_ENV="development"
