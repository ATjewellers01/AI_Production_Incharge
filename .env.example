# ── Database (READ-ONLY use only — this service never writes) ───────────────
# LOCAL TESTING: point this at your local restored copy (e.g. `o2d_local` in
# pgAdmin, restored from updatebackupnewone.backup):
#   DATABASE_URL="postgresql://postgres:<password>@localhost:5432/o2d_local"
#
# RENDER DEPLOY (Option A — separate cloud test DB, not the real production
# one): create a small Postgres instance on Render (or Neon/Supabase free
# tier), restore the SAME updatebackupnewone.backup into it via pgAdmin, and
# paste that instance's connection string here as an Environment Variable in
# the Render dashboard (not committed to git):
#   DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# MUST be the exact same value as at-order-to-dispatch-backend's own
# JWT_SECRET — this service verifies tokens O2D issues, it never issues its
# own. If this doesn't match, every login will fail with "Invalid or expired
# token" even with a correct password.
JWT_SECRET=""

# Local-dev-only convenience: when NODE_ENV is NOT "production" AND this is
# exactly "true", every API route skips auth entirely and acts as a fake
# SUPER_ADMIN (see lib/auth.ts). Leave unset/false normally, and NEVER set
# this in the Render environment (Render sets NODE_ENV=production itself,
# which disables the bypass regardless, but don't rely on that alone).
SKIP_AUTH_IN_DEV="false"

# ── OpenAI (dashboard narrative + chat) ──────────────────────────────────────
OPENAI_API_KEY=""
# Optional — defaults to gpt-4o if unset.
AI_INCHARGE_MODEL="gpt-4o"

# ── O2D's own API (the browser calls this directly for login only) ──────────
# Local: at-order-to-dispatch-backend running on its default port.
# Render: O2D's real public API URL (e.g. https://api-o2d.zold.in/api).
NEXT_PUBLIC_O2D_API_URL="http://localhost:5000/api"

# Render sets PORT itself; local dev ignores it (Next.js defaults to 3000,
# but this service's own `start` script defaults to 3100 to avoid clashing
# with Jewel Factory or O2D's frontend if all three run locally at once).
PORT="3100"
NODE_ENV="development"
